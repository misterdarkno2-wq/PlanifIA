{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlanifIA",
  "version": "1.1.0",
  "identifier": "com.planifia.app",
  "build": {"frontendDist": "../frontend"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "main", "title": "PlanifIA", "width": 430, "height": 880, "minWidth": 360, "minHeight": 600, "backgroundColor": "#f5f7f9"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": {"minSdkVersion": 24}
  }
}
